# Forge Admin secrets -- copy to ~/.secrets and fill in your values.
# The bridge loads these at startup via _load_secrets_file().

# Create a Telegram bot via @BotFather, then get your chat ID via @userinfobot.
export FORGE_TELEGRAM_TOKEN="YOUR_BOT_TOKEN_HERE"
export FORGE_TELEGRAM_CHAT_ID="YOUR_CHAT_ID_HERE"
